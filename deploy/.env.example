# Production-shaped configuration example only.
# Store real deployment values in the Northflank runtime secret group.

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-new-random-secret
DEBUG=False
ALLOWED_HOSTS=api.example.com,localhost
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com

# PostgreSQL
DB_NAME=chatpulse
DB_USER=chatpulse_app
DB_PASSWORD=replace-with-the-application-role-password
DB_HOST=postgres.example.internal
DB_PORT=5432
CONN_MAX_AGE=300

# Redis
REDIS_URL=rediss://default:replace-with-password@redis.example.com:6379

# Kafka
KAFKA_BROKER=kafka.example.com:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=replace-with-service-user
KAFKA_SASL_PASSWORD=replace-with-service-password
KAFKA_SSL_CA_LOCATION=

# Gunicorn
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# HTTPS / security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
