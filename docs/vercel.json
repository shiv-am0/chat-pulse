{
  "version": 2,
  "builds": [
    { "src": "/index.html", "use": "@vercel/static" },
    { "src": "/install.sh", "use": "@vercel/static",
      "config": { "contentType": "text/x-shellscript" } },
    { "src": "/install.ps1", "use": "@vercel/static",
      "config": { "contentType": "text/x-powershell" } }
  ],
  "routes": [
    {
      "src": "/install.ps1",
      "headers": { "Content-Type": "text/plain; charset=utf-8" },
      "continue": true
    },
    {
      "src": "/install.sh",
      "headers": { "Content-Type": "text/plain; charset=utf-8" },
      "continue": true
    },
    { "src": "/", "dest": "/index.html" }
  ]
}
